kind: User
metadata:
  name: __CONNECTOR_USER__
  displayName: "__SITE_DISPLAY_NAME__ Workload Connector"
spec:
  type: WORKLOAD
---
kind: Service
metadata:
  name: __SITE_SLUG__
  displayName: "__SITE_DISPLAY_NAME__"
spec:
  mode: WEB
  isPublic: true
__TRUSTED_HEADERS_BLOCK__
  config:
    tls:
      insecureSkipVerify: true
    http:
__TRUSTED_AUTH_BLOCK__
      header:
        authorizationMode: PASS
        host:
          preserve: true
    upstream:
      user: __CONNECTOR_USER__
      url: https://gateway:8443
