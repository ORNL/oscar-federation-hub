version: 1
metadata:
  name: OSCAR Federation Hub — Groups, Scopes & OIDC Application
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  # 1. Pre-create the three canonical OSCAR RBAC groups so admins can assign access in 1 click
  - model: authentik_core.group
    id: group-oscar-admins
    identifiers:
      name: oscar-admins
    attrs:
      is_superuser: false
      attributes:
        description: "Full Administrator control across Octelium tunnel services and federated OSCAR nodes."

  - model: authentik_core.group
    id: group-oscar-operators
    identifiers:
      name: oscar-operators
    attrs:
      is_superuser: false
      attributes:
        description: "Live lane monitoring, alarm acknowledgment, adjudication, and report generation."

  - model: authentik_core.group
    id: group-oscar-viewers
    identifiers:
      name: oscar-viewers
    attrs:
      is_superuser: false
      attributes:
        description: "Read-only National View, Event Log, video/spectrum review, and report viewing."

  # 2. Scope mapping that emits standard `groups` array in OIDC ID tokens and UserInfo
  - model: authentik_providers_oauth2.scopemapping
    id: scope-oscar-groups
    identifiers:
      managed: goauthentik.io/providers/oauth2/oscar-federation-groups
    attrs:
      name: "OSCAR Federation Groups Claim"
      scope_name: groups
      description: "Includes assigned OSCAR role groups (oscar-admins, oscar-operators, oscar-viewers) in OIDC tokens."
      expression: |
        return {
            "groups": [group.name for group in request.user.ak_groups.all()],
        }

  # 3. Shared OAuth2 / OIDC Provider pre-wired for Octelium Hub + federated OSCAR nodes
  - model: authentik_providers_oauth2.oauth2provider
    id: provider-oscar-federation
    identifiers:
      name: oscar-federation-oidc-provider
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: "__OIDC_CLIENT_ID__"
      client_secret: "__OIDC_CLIENT_SECRET__"
      sub_mode: user_username
      include_claims_in_id_token: true
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
        - !KeyOf scope-oscar-groups
      redirect_uris:
        - matching_mode: strict
          url: "https://__HUB_DOMAIN__/callback"
        - matching_mode: strict
          url: "https://__HUB_DOMAIN__/oauth2/callback"
        - matching_mode: regex
          url: '^https://[a-z0-9-]+\.__HUB_DOMAIN_ESCAPED__/login/oidc/callback$'

  # 4. Authentik Application visible in the user portal
  - model: authentik_core.application
    id: app-oscar-federation
    identifiers:
      slug: oscar-federation-sso
    attrs:
      name: "OSCAR Federated Sites & Tunnel"
      provider: !KeyOf provider-oscar-federation
      meta_launch_url: "https://portal.__HUB_DOMAIN__"
      policy_engine_mode: any

  # 5. Single-use SSO Passkey onboarding link flow ("Create recovery link" in Users admin)
  - model: authentik_flows.flow
    id: flow-oscar-passkey-onboarding
    identifiers:
      slug: oscar-passkey-onboarding
    attrs:
      name: "OSCAR SSO Passkey Onboarding"
      title: "Set Up Your OSCAR SSO Passkey"
      designation: recovery
      authentication: none
      layout: stacked

  - model: authentik_policies_expression.expressionpolicy
    id: policy-oscar-require-recovery-token
    identifiers:
      name: oscar-passkey-require-recovery-token
    attrs:
      expression: |
        return not bool(request.context.get("is_restored", False))

  - model: authentik_stages_deny.denystage
    id: stage-oscar-deny-without-token
    identifiers:
      name: oscar-passkey-deny-without-token
    attrs:
      deny_message: "A valid single-use Passkey setup link from an OSCAR administrator is required."

  - model: authentik_stages_authenticator_webauthn.authenticatorwebauthnstage
    id: stage-oscar-passkey-setup
    identifiers:
      name: oscar-passkey-webauthn-setup
    attrs:
      friendly_name: "OSCAR SSO Passkey"
      resident_key_requirement: required
      user_verification: preferred
      configure_flow: !Find [authentik_flows.flow, [slug, default-authenticator-webauthn-setup]]

  - model: authentik_flows.flowstagebinding
    id: binding-onboarding-deny
    identifiers:
      target: !KeyOf flow-oscar-passkey-onboarding
      stage: !KeyOf stage-oscar-deny-without-token
      order: 0
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
      policy_engine_mode: any

  - model: authentik_policies.policybinding
    identifiers:
      policy: !KeyOf policy-oscar-require-recovery-token
      target: !KeyOf binding-onboarding-deny
      order: 0
    attrs:
      enabled: true
      negate: false
      timeout: 30

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow-oscar-passkey-onboarding
      stage: !KeyOf stage-oscar-passkey-setup
      order: 10
    attrs:
      evaluate_on_plan: true
      re_evaluate_policies: false

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow-oscar-passkey-onboarding
      stage: !Find [authentik_stages_user_login.userloginstage, [name, default-authentication-login]]
      order: 20
    attrs:
      evaluate_on_plan: true
      re_evaluate_policies: false

  # 6. Passwordless Passkey SSO sign-in flow ("Use a security key" on Authentik login)
  - model: authentik_flows.flow
    id: flow-oscar-passkey-login
    identifiers:
      slug: oscar-passkey-login
    attrs:
      name: "OSCAR Passkey Login"
      title: "Sign In with OSCAR SSO Passkey"
      designation: authentication
      authentication: require_unauthenticated
      layout: stacked

  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    id: stage-oscar-passkey-validate
    identifiers:
      name: oscar-passkey-webauthn-validate
    attrs:
      device_classes:
        - webauthn
      not_configured_action: deny
      webauthn_user_verification: preferred

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow-oscar-passkey-login
      stage: !KeyOf stage-oscar-passkey-validate
      order: 10
    attrs:
      evaluate_on_plan: true
      re_evaluate_policies: false

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow-oscar-passkey-login
      stage: !Find [authentik_stages_user_login.userloginstage, [name, default-authentication-login]]
      order: 20
    attrs:
      evaluate_on_plan: true
      re_evaluate_policies: false

  - model: authentik_stages_identification.identificationstage
    identifiers:
      name: default-authentication-identification
    attrs:
      user_fields:
        - email
        - username
      passwordless_flow: !KeyOf flow-oscar-passkey-login

  - model: authentik_brands.brand
    identifiers:
      domain: authentik-default
    attrs:
      flow_recovery: !KeyOf flow-oscar-passkey-onboarding
